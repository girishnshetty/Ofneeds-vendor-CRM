  "devDependencies": {
    "typescript": "5.8.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "22.14.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
