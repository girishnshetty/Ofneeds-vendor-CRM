PORT=4310
HOST=127.0.0.1
APP_URL=http://127.0.0.1:4310
# CRM_DATA_DIR=/absolute/path/to/private/persistent/data
# Production requires HTTPS APP_URL and a stable random 32-byte encryption key (64 hex chars).
# CRM_ENCRYPTION_KEY=
# Local-only worker: 0 disables scheduling. No supplier message is auto-dispatched.
CRM_AUTOMATION_INTERVAL_SECONDS=60
# Production defaults to 24 hours; development defaults to disabled (0).
# CRM_BACKUP_INTERVAL_HOURS=24
# HTTPS adapter endpoints, NOT browser-visible credentials. See docs/OPERATIONS.md.
# CRM_MAIL_GATEWAY_URL=
# CRM_MAIL_GATEWAY_TOKEN=
# CRM_MAIL_FROM=
# CRM_WHATSAPP_GATEWAY_URL=
# CRM_WHATSAPP_GATEWAY_TOKEN=
# CRM_SCAN_GATEWAY_URL=
# CRM_SCAN_GATEWAY_TOKEN=
# Comma-separated, operator-approved HTTPS webhook hostnames.
# CRM_WEBHOOK_ALLOWED_HOSTS=hooks.your-company.example
# CRM_BILLING_WEBHOOK_SECRET=
# No default paid prices. Set verified amounts in integer paise, with a human-readable label.
# CRM_BILLING_CATALOG_JSON={"team":{"amountPaise":10000,"label":"Your Team price"}}
# Test adapters on loopback only; leave disabled in production.
# CRM_ALLOW_LOCAL_GATEWAY=false
